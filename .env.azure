# Production build for Azure (`npm run build:azure` = vite build --mode azure). Overrides .env.
# Fill in once the Azure resources exist (TournamentScheduler.Api/deploy/azure/README.md, step 9):
#   - the API web app's address (App Service -> Overview -> Default domain), ending in /api
#   - the PRODUCTION gateway key's id and public half (never the laptop's 20260929 key)
# Both are public by design; only the server's private key can read what is sealed with them.
VITE_API_BASE_URL=https://<api-default-domain>/api
VITE_GATEWAY_KEY_ID=<production-key-id>
VITE_GATEWAY_PUBLIC_KEY=<production-public-key>
